    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "file-type": "^22.0.2",
    "helmet": "^8.1.0",
    "image-size": "^2.0.2",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.2",
    "markdown-it": "^15.0.1",
    "mongoose": "^8.10.0",
    "multer": "^2.0.0",
    "nanoid": "^5.1.0",
    "zod": "^4.0.0"
