# --- server ---
PORT=4000
NODE_ENV=development

# --- database ---
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# --- auth ---
# 32+ random bytes: openssl rand -base64 48
JWT_SECRET=
# Leave empty in development. In production set the registrable domain so the
# cookie is shared by yoursite.com and api.yoursite.com (Technical PRD §6).
COOKIE_DOMAIN=

# --- cors ---
# Exact origin. Never '*' when credentials are sent.
CORS_ORIGIN=http://localhost:5173

# Absolute origin of the public site — used for links in the Atom feed.
# MUST be set to the real public origin in production; the server refuses to
# start with a localhost value when NODE_ENV=production.
PUBLIC_SITE_URL=http://localhost:5173

# --- uploads ---
UPLOAD_DIR=./uploads
PUBLIC_STATIC_PATH=/static

# --- telegram (contact relay, M6) ---
# MUST be a freshly issued token. The old one is public in git history.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- seed only: delete these once `npm run seed:admin` has been run ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
